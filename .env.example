# Copie para .env e ajuste as senhas: cp .env.example .env

# Usuário proprietário do banco (usado pela API e pelas migrações)
POSTGRES_USER=atelieflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=atelieflow

# Senha do usuário read-only (integrações de AI/BI — somente SELECT)
LEITURA_PASSWORD=troque-esta-senha-leitura

# Interface de bind da porta 5432 no host.
# 127.0.0.1 = apenas esta máquina | 0.0.0.0 = acessível na rede local (LAN)
DB_BIND=127.0.0.1
